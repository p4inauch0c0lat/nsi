import random

#PARTIE 1
def affichage_annee(numero):
    print("=====================================")
    print("Année", numero)


# cette fonction prend un tableau et un nombre d'années et donne une probabilité
# de 0.7 à un arbre de grandir de 1
def croissance_arbres(tableau, années):
    print(tableau)
    for i in range(années):
        affichage_annee(i + 1)
        for valeur in range(len(tableau)):
            grandi_ou_non=random.uniform(0,1)
            if grandi_ou_non<=0.7:
                tableau[valeur]+=1
        affichage_arbres(tableau)
        print()

# cette fonction permet d'afficher les arbres à l'horizontal
def affichage_arbres(tableau):
    for i in range(len(tableau)):
        print(tableau[i]*"I")

# cette fonction prend compte du soleil et de l'ombre pour la pousse des arbres
# si la valeur d'avant est plus grande que la suivante dans le tableau, alors
# elle ne poussera que de un alors qu'un arbre au soleil poussera de deux
def croissance_arbres_soleil(tableau, années):
    print(tableau)
    for i in range(années):
        affichage_annee(i + 1)
        for valeur in range(len(tableau)):
            if valeur > 0 and tableau[valeur-1]>tableau[valeur]:
                grandi_ombre=random.uniform(0,1)
                if grandi_ombre>=0.7:
                    tableau[valeur]+=random.randint(1,3)
            else:
                tableau[valeur]+=2
        affichage_arbres(tableau)
        print()

#PARTIE 2
# ce simulateur prend en compte les voisins de chaque côté d'une valeur, les
# chances de pousser de l'arbre seront réduites si il est encerclé par des arbres
# plus grand
def croissance_partie_2(tableau, années):
    print(tableau)
    for i in range(années):
        affichage_annee(i + 1)

        if tableau[0]<tableau[1]:
            grandi_mi_ombre=random.uniform(0,1)
            if grandi_mi_ombre<=0.5:
                tableau[0]+=random.randint(1,3)
        else :
            grandi_soleil = random.uniform(0,1)
            if grandi_soleil<=0.9:
                tableau[0]+=random.randint(1,4)

        if tableau[len(tableau)-1]<tableau[len(tableau)-2]:
            grandi_mi_ombre=random.uniform(0,1)
            if grandi_mi_ombre<=0.5:
                tableau[len(tableau)-1]+=random.randint(1,3)
        else :
            grandi_soleil = random.uniform(0,1)
            if grandi_soleil<=0.9:
                tableau[len(tableau)-1]+=random.randint(1,4)

        for valeur in range(1, len(tableau)-1):
            if tableau[valeur-1] > tableau[valeur] and tableau[valeur+1] > tableau[valeur]:
                tableau[valeur] += 0
            elif tableau[valeur-1] < tableau[valeur] and tableau[valeur+1] < tableau[valeur]:
                grandi_soleil = random.uniform(0,1)
                if grandi_soleil<=0.9:
                    tableau[valeur]+=random.randint(1,4)
                else:
                    tableau[valeur]+=random.randint(0,3)
            else:
                grandi_mi_ombre=random.uniform(0,1)
                if grandi_mi_ombre<=0.5:
                    tableau[valeur]+=random.randint(1,3)
        affichage_arbres(tableau)

def croissance_partie_2_voisins_eloignes(tableau, annees):
    print(tableau)
    for annee in range(annees):
        affichage_annee(annee + 1)
        for i in range(len(tableau)):
            if i + 3 < len(tableau):
                arbres_eloignes = tableau[i+1:i+4]

                if tableau[i]>min(arbres_eloignes):
                    for j in range (i+1, i+4):
                        tableau[j]+=random.randint(1,2)
                else:
                    tableau[i]+=random.randint(1,3)
        affichage_arbres(tableau)
        print()
        

#Partie 3 simulateur meteo

def croissance_partie_3_meteo(tableau, annees):
    print(tableau)

    for annee in range(annees):
        affichage_annee(annee + 1)
        evenement = random.uniform(0,1)

        if evenement < 0.25:
            print("Événement météo : TEMPÊTE")
            maxi = max(tableau)
            for i in range(len(tableau)):
                if tableau[i] == maxi:
                    tableau[i] = max(0, tableau[i] - random.randint(2,4))

        elif evenement < 0.50:
            print("Événement météo : GLISSEMENT DE TERRAIN")
            mini = min(tableau)
            for i in range(len(tableau)):
                if tableau[i] == mini:
                    tableau[i] = 0

        elif evenement < 0.75:
            print("Événement météo : ANNÉE FAVORABLE")
            for i in range(len(tableau)):
                tableau[i] += random.randint(1,2)

        else:
            print("Événement météo : INCENDIE")
            depart = random.randint(0, len(tableau)-1)
            tableau[depart] = max(0, tableau[depart] - random.randint(2,4))

            if depart > 0 and random.uniform(0,1) < 0.4:
                tableau[depart-1] = max(0, tableau[depart-1] - 2)
            if depart < len(tableau)-1 and random.uniform(0,1) < 0.4:
                tableau[depart+1] = max(0, tableau[depart+1] - 2)

        affichage_arbres(tableau)
        print()


#Partie 3 simulateur maladies


def croissance_partie_3_maladies(tableau, annees):
    print(tableau)

    maladies = [0 for _ in range(len(tableau))]

    for annee in range(annees):
        affichage_annee(annee + 1)
        for i in range(len(tableau)):

            if maladies[i] == 0 and random.uniform(0,1) < 0.05:
                maladies[i] = 1

            if maladies[i] == 1:
                if i > 0 and random.uniform(0,1) < 0.3:
                    maladies[i-1] = 1
                if i < len(tableau)-1 and random.uniform(0,1) < 0.3:
                    maladies[i+1] = 1

                effet = random.uniform(0,1)
                if effet < 0.2:
                    tableau[i] = 0
                    maladies[i] = 0
                elif effet < 0.5:
                    maladies[i] = 0

            if random.uniform(0,1) < 0.6:
                tableau[i] += 1

        affichage_arbres(tableau)
        print()
        

#Partie 3 simulateur morts naturelle


def croissance_partie_3_mort_naturelle(tableau, annees):
    print(tableau)

    sans_croissance = [0 for _ in range(len(tableau))]

    for annee in range(annees):
        affichage_annee(annee + 1)
        for i in range(len(tableau)):
            avant = tableau[i]

            if random.uniform(0,1) < 0.6:
                tableau[i] += 1

            if tableau[i] == avant:
                sans_croissance[i] += 1
            else:
                sans_croissance[i] = 0

        for i in range(1, len(tableau)-1):
            if sans_croissance[i] >= 3:
                tableau[i] = 0

            if tableau[i] + 3 < tableau[i-1] and tableau[i] + 3 < tableau[i+1]:
                tableau[i] = 0

        affichage_arbres(tableau)
        print()


