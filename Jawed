def menu():
    print("\n=== Simulation de croissance de forêt ===")
    print("1 - Croissance simple")
    print("2 - Soleil / ombre (gauche)")
    print("3 - Ombre à distance 2")
    print("4 - Ensoleillement bilatéral")
    print("5 - Écosystème dynamique (Partie 3)")

    choix = input("Votre choix (1-5) : ").strip()
    try:
        nb_arbres = int(input("Nombre d'arbres : "))
        nb_annees = int(input("Nombre d'années : "))
    except ValueError:
        print("Erreur : Veuillez entrer des nombres entiers.")
        return

    if choix == "1": simulateur_croissance_simple(nb_arbres, nb_annees)
    elif choix == "2": simulateur_croissance_soleil(nb_arbres, nb_annees)
    elif choix == "3": simulateur_distance2(nb_arbres, nb_annees)
    elif choix == "4": simulateur_bilateral(nb_arbres, nb_annees)
    elif choix == "5": simulateur_ecosysteme_dynamique(nb_arbres, nb_annees)
    else: print("Choix invalide.")

if __name__ == "__main__":
    menu()
