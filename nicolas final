#cette fonction prend un tableau et un nombre d'années et donne une probabilité
#de 0.7 à un arbre de grandir de 1
def croissance_arbres(tableau, années):
    print(tableau)
    for i in range(années):
        for valeur in range(len(tableau)):
            grandi_ou_non=random.uniform(0,1)
            if grandi_ou_non<=0.7:
                tableau[valeur]+=1
        affichage_arbres(tableau)
        print()

#cette fonction permet d'afficher les arbres à l'horizontal
def affichage_arbres(tableau):
    for i in range(len(tableau)):
        print(tableau[i]*"I")


#cette fonction prend compte du soleil et de l'ombre pour la pousse des arbres
#si la valeur d'avant est plus grande que la suivante dans le tableau, alors
#elle ne poussera que de un alors qu'un arbre au soleil poussera de deux
def croissance_arbres_soleil(tableau, années):
    print(tableau)
    for i in range(années):
        for valeur in range(len(tableau)):
            if tableau[valeur-1]>tableau[valeur]:
                grandi_ombre=random.uniform(0,1)
                if grandi_ombre>=0.7:
                    tableau[valeur]+=random.randint(1,3)
            else:
                tableau[valeur]+=2
        affichage_arbres(tableau)
        print()

#PARTIE 2

#ce simulateur prend en compte les voisins de chaque côté d'une valeur, les
#chances de pousser de l'arbre seront réduites si il est encerclé par des arbres
#plus grand
def croissance_partie_2(tableau, années):
    print(tableau)
    for i in range(années):
        if tableau[0]<tableau[1]:
            grandi_mi_ombre=random.uniform(0,1)
            if grandi_mi_ombre<=0.5:
                tableau[0]+=random.randint(1,3)
        else :
            grandi_soleil = random.uniform(0,1)
            if grandi_soleil<=0.9:
                tableau[0]+=random.randint(1,4)

        if tableau[len(tableau)-1]<tableau[len(tableau)-2]:
            grandi_mi_ombre=random.uniform(0,1)
            if grandi_mi_ombre<=0.5:
                tableau[len(tableau)-1]+=random.randint(1,3)
        else :
            grandi_soleil = random.uniform(0,1)
            if grandi_soleil<=0.9:
                tableau[len(tableau)-1]+=random.randint(1,4)


        for valeur in range(1, len(tableau)-1):
            if tableau[valeur-1] > tableau[valeur] and tableau[valeur+1] > tableau[valeur]:
                tableau[valeur] += 0
            elif tableau[valeur-1] < tableau[valeur] and tableau[valeur+1] < tableau[valeur]:
                grandi_soleil = random.uniform(0,1)
                if grandi_soleil<=0.9:
                    tableau[valeur]+=random.randint(1,4)
                else:
                    tableau[valeur]+=random.randint(0,3)
            else:
                grandi_mi_ombre=random.uniform(0,1)
                if grandi_mi_ombre<=0.5:
                    tableau[valeur]+=random.randint(1,3)
        affichage_arbres(tableau)

